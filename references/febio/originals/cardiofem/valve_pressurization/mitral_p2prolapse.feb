	</MeshData>
	<Boundary>
		<bc name="Annulus Displacement" node_set="AnnulusNodes" type="zero displacement">
			<x_dof>1</x_dof>
			<y_dof>1</y_dof>
			<z_dof>1</z_dof>
		</bc>
		<bc name="Papillary Muscle Displacement" node_set="PapillaryNodes" type="zero displacement">
			<x_dof>1</x_dof>
			<y_dof>1</y_dof>
			<z_dof>1</z_dof>
		</bc>
		<bc name="Annulus Rotation" node_set="AnnulusNodes" type="zero shell displacement">
			<sx_dof>1</sx_dof>
			<sy_dof>1</sy_dof>
			<sz_dof>1</sz_dof>
		</bc>
	</Boundary>
	<Loads>
		<body_load elem_set="Part3" type="mass damping">
			<C>3000</C>
		</body_load>
	</Loads>
	<Contact>
		<contact name="Contact Potential (Leaflets)" surface_pair="Contact Potential (Leaflets)" type="contact potential">
			<laugon>PENALTY</laugon>
			<kc>2</kc>
			<p>4</p>
			<R_in>0.2</R_in>
			<R_out>0.5</R_out>
			<R0_min>0</R0_min>
			<w_tol>0.6</w_tol>
		</contact>
	</Contact>
	<Discrete>
		<discrete_material id="1" name="A1" type="nonlinear spring">
			<scale>60</scale>
			<measure>elongation</measure>
			<force type="point">
				<interpolate>linear</interpolate>
				<extend>extrapolate</extend>
				<points>
					<pt>0,0</pt>
					<pt>4,0</pt>
					<pt>5,1</pt>
				</points>
			</force>
		</discrete_material>
		<discrete_material id="2" name="A2_1" type="nonlinear spring">
			<scale>60</scale>
			<measure>elongation</measure>
			<force type="point">
				<interpolate>linear</interpolate>
				<extend>extrapolate</extend>
				<points>
					<pt>0,0</pt>
					<pt>4,0</pt>
					<pt>5,1</pt>
				</points>
			</force>
		</discrete_material>
		<discrete_material id="3" name="A2_2" type="nonlinear spring">
			<scale>60</scale>
			<measure>elongation</measure>
			<force type="point">
				<interpolate>linear</interpolate>
				<extend>extrapolate</extend>
				<points>
					<pt>0,0</pt>
					<pt>4,0</pt>
					<pt>5,1</pt>
				</points>
			</force>
		</discrete_material>
		<discrete_material id="4" name="A3" type="nonlinear spring">
			<scale>60</scale>
			<measure>elongation</measure>
			<force type="point">
				<interpolate>linear</interpolate>
				<extend>extrapolate</extend>
				<points>
					<pt>0,0</pt>
					<pt>2,0</pt>
					<pt>3,1</pt>
				</points>
			</force>
		</discrete_material>
		<discrete_material id="5" name="P1" type="nonlinear spring">
			<scale>30</scale>
			<measure>elongation</measure>
			<force type="point">
				<interpolate>linear</interpolate>
				<extend>extrapolate</extend>
				<points>
					<pt>0,0</pt>
					<pt>3,0</pt>
					<pt>4,1</pt>
				</points>
			</force>
		</discrete_material>
		<discrete_material id="6" name="P2_1" type="nonlinear spring">
			<scale>30</scale>
			<measure>elongation</measure>
			<force type="point">
				<interpolate>linear</interpolate>
				<extend>extrapolate</extend>
				<points>
					<pt>0,0</pt>
					<pt>12,0</pt>
					<pt>13,1</pt>
				</points>
			</force>
		</discrete_material>
		<discrete_material id="7" name="P3" type="nonlinear spring">
			<scale>30</scale>
			<measure>elongation</measure>
			<force type="point">
				<interpolate>linear</interpolate>
				<extend>extrapolate</extend>
				<points>
					<pt>0,0</pt>
					<pt>3,0</pt>
					<pt>4,1</pt>
				</points>
			</force>
		</discrete_material>
		<discrete_material id="8" name="P2_2" type="nonlinear spring">
			<scale>30</scale>
			<measure>elongation</measure>
			<force type="point">
				<interpolate>linear</interpolate>
				<extend>extrapolate</extend>
				<points>
					<pt>0,0</pt>
					<pt>12,0</pt>
					<pt>13,1</pt>
				</points>
			</force>
		</discrete_material>
		<discrete dmat="1" discrete_set="A1"/>
		<discrete dmat="2" discrete_set="A2_1"/>
		<discrete dmat="3" discrete_set="A2_2"/>
		<discrete dmat="4" discrete_set="A3"/>
		<discrete dmat="5" discrete_set="P1"/>
		<discrete dmat="6" discrete_set="P2_1"/>
		<discrete dmat="7" discrete_set="P3"/>
		<discrete dmat="8" discrete_set="P2_2"/>
	</Discrete>
	<Step>
		<step id="1" name="01 - Valve Close/Clip Open">
			<Control>
				<analysis>DYNAMIC</analysis>
				<time_steps>200</time_steps>
				<step_size>0.0001</step_size>
				<plot_zero_state>0</plot_zero_state>
				<plot_range>0,-1</plot_range>
				<plot_level>PLOT_MAJOR_ITRS</plot_level>
				<output_level>OUTPUT_MAJOR_ITRS</output_level>
				<plot_stride>1</plot_stride>
				<output_stride>1</output_stride>
				<adaptor_re_solve>1</adaptor_re_solve>
				<time_stepper type="default">
					<max_retries>5</max_retries>
					<opt_iter>10</opt_iter>
					<dtmin>1e-05</dtmin>
					<dtmax>0.0001</dtmax>
					<aggressiveness>0</aggressiveness>
					<cutback>0.5</cutback>
					<dtforce>0</dtforce>
				</time_stepper>
				<solver type="solid">
					<symmetric_stiffness>symmetric</symmetric_stiffness>
					<equation_scheme>staggered</equation_scheme>
					<equation_order>default</equation_order>
					<optimize_bw>0</optimize_bw>
					<lstol>0.9</lstol>
					<lsmin>0.01</lsmin>
					<lsiter>5</lsiter>
					<max_refs>15</max_refs>
					<check_zero_diagonal>0</check_zero_diagonal>
					<zero_diagonal_tol>0</zero_diagonal_tol>
					<force_partition>0</force_partition>
					<reform_each_time_step>1</reform_each_time_step>
					<reform_augment>0</reform_augment>
					<diverge_reform>1</diverge_reform>
					<min_residual>1e-20</min_residual>
					<max_residual>0</max_residual>
					<dtol>0.001</dtol>
					<etol>0.01</etol>
					<rtol>0</rtol>
					<rhoi>0</rhoi>
					<alpha>1</alpha>
					<beta>0.25</beta>
					<gamma>0.5</gamma>
					<logSolve>0</logSolve>
					<arc_length>0</arc_length>
					<arc_length_scale>0</arc_length_scale>
					<qn_method type="BFGS">
						<max_ups>10</max_ups>
						<max_buffer_size>0</max_buffer_size>
						<cycle_buffer>1</cycle_buffer>
						<cmax>100000</cmax>
					</qn_method>
				</solver>
			</Control>
			<Loads>
				<surface_load name="Pressure Load Initial - 1" surface="ValvePressureLoad" type="pressure">
					<pressure lc="1">-13.3</pressure>
					<symmetric_stiffness>1</symmetric_stiffness>
					<linear>0</linear>
					<shell_bottom>0</shell_bottom>
				</surface_load>
			</Loads>
		</step>
	</Step>
	<LoadData>
		<load_controller id="1" name="Pressure Close Control (Initial)" type="loadcurve">
			<interpolate>SMOOTH</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>0.005,1</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
			<var type="relative volume"/>
			<var type="contact gap"/>
			<var type="discrete element force"/>
			<var type="shell thickness"/>
			<var type="Lagrange strain"/>
			<var type="contact pressure"/>
		</plotfile>
		<logfile>
			<element_data data="Ux;Uy;Uz;s1;E1" file="mitral_p2Prolapse_output.csv" elem_set="mitral"/>
			<element_data data="Ux;Uy;Uz;s1;E1" file="A1_p2Prolapse.csv" elem_set="A1"/>
			<element_data data="Ux;Uy;Uz;s1;E1" file="A2_p2Prolapse.csv" elem_set="A2"/>
			<element_data data="Ux;Uy;Uz;s1;E1" file="A3_p2Prolapse.csv" elem_set="A3"/>
			<element_data data="Ux;Uy;Uz;s1;E1" file="P1_p2Prolapse.csv" elem_set="P1"/>
			<element_data data="Ux;Uy;Uz;s1;E1" file="P2_p2Prolapse.csv" elem_set="P2"/>
			<element_data data="Ux;Uy;Uz;s1;E1" file="P3_p2Prolapse.csv" elem_set="P3"/>
			<face_data data="contact gap" file = "mitral_p2Prolapse_contact.csv" surface="ContactLeaflet"/>
			<surface_data data="contact area" file="contactarea_p2Prolapse_sev.csv" surface="ContactLeaflet"/>
		</logfile>
	</Output>
</febio_spec>
