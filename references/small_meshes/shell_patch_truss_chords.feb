<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
The curved 3 x 3 quad4 shell patch of shell_patch.feb, clamped on one edge, with its
opposite edge held by four truss chords from one fixed point, and lifted by a nodal load
on every node that is not clamped. Trusses sharing nodes with shell elements. Synthetic.
-->
<febio_spec version="4.0">
	<Module type="solid" />
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>10</time_steps>
		<step_size>0.1</step_size>
		<plot_zero_state>0</plot_zero_state>
		<plot_range>0,-1</plot_range>
		<plot_level>PLOT_MAJOR_ITRS</plot_level>
		<output_level>OUTPUT_MAJOR_ITRS</output_level>
		<plot_stride>1</plot_stride>
		<output_stride>1</output_stride>
		<solver type="solid">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
			<lstol>0.9</lstol>
			<lsmin>0.01</lsmin>
			<lsiter>5</lsiter>
			<max_refs>15</max_refs>
			<diverge_reform>1</diverge_reform>
			<reform_each_time_step>1</reform_each_time_step>
			<min_residual>1e-20</min_residual>
			<dtol>1e-08</dtol>
			<etol>1e-12</etol>
			<rtol>0</rtol>
			<qn_method type="BFGS">
				<max_ups>0</max_ups>
			</qn_method>
		</solver>
	</Control>
	<Globals>
		<Constants>
			<T>0</T>
			<P>0</P>
			<R>8.31446</R>
			<Fc>96485.3</Fc>
		</Constants>
	</Globals>
	<Material>
		<material id="1" name="Material1" type="neo-Hookean">
			<density>1</density>
			<E>1</E>
			<v>0.3</v>
		</material>
		<material id="2" name="Chord" type="linear truss">
			<density>1</density>
			<E>20</E>
		</material>
	</Material>
	<Mesh>
		<Nodes name="Object1">
			<node id="1">0.0,0.0,0.0</node>
			<node id="2">0.3333333333333333,0.0,0.033333333333333326</node>
			<node id="3">0.6666666666666666,0.0,0.1333333333333333</node>
			<node id="4">1.0,0.0,0.3</node>
			<node id="5">0.0,0.3333333333333333,0.03333333333333333</node>
			<node id="6">0.3333333333333333,0.3333333333333333,0.06666666666666665</node>
			<node id="7">0.6666666666666666,0.3333333333333333,0.16666666666666663</node>
			<node id="8">1.0,0.3333333333333333,0.3333333333333333</node>
			<node id="9">0.0,0.6666666666666666,0.06666666666666667</node>
			<node id="10">0.3333333333333333,0.6666666666666666,0.09999999999999999</node>
			<node id="11">0.6666666666666666,0.6666666666666666,0.19999999999999996</node>
			<node id="12">1.0,0.6666666666666666,0.36666666666666664</node>
			<node id="13">0.0,1.0,0.1</node>
			<node id="14">0.3333333333333333,1.0,0.13333333333333333</node>
			<node id="15">0.6666666666666666,1.0,0.2333333333333333</node>
			<node id="16">1.0,1.0,0.4</node>
		</Nodes>
		<Nodes name="Apex">
			<node id="17">1.5,0.5,-1.0</node>
		</Nodes>
		<Elements type="quad4" name="Part1">
			<elem id="1">1,2,6,5</elem>
			<elem id="2">2,3,7,6</elem>
			<elem id="3">3,4,8,7</elem>
			<elem id="4">5,6,10,9</elem>
			<elem id="5">6,7,11,10</elem>
			<elem id="6">7,8,12,11</elem>
			<elem id="7">9,10,14,13</elem>
			<elem id="8">10,11,15,14</elem>
			<elem id="9">11,12,16,15</elem>
		</Elements>
		<Elements type="line2" name="Chords">
			<elem id="10">17,4</elem>
			<elem id="11">17,8</elem>
			<elem id="12">17,12</elem>
			<elem id="13">17,16</elem>
		</Elements>
		<NodeSet name="Clamped">1,5,9,13</NodeSet>
		<NodeSet name="ApexNode">17</NodeSet>
		<NodeSet name="Loaded">2,3,4,6,7,8,10,11,12,14,15,16</NodeSet>
	</Mesh>
	<MeshDomains>
		<ShellDomain name="Part1" mat="Material1" type="elastic-shell">
			<shell_thickness>0.1</shell_thickness>
		</ShellDomain>
		<BeamDomain name="Chords" mat="Chord" type="linear-truss">
			<cross_sectional_area>0.01</cross_sectional_area>
		</BeamDomain>
	</MeshDomains>
	<Boundary>
		<bc name="ClampFront" node_set="Clamped" type="zero displacement">
			<x_dof>1</x_dof>
			<y_dof>1</y_dof>
			<z_dof>1</z_dof>
		</bc>
		<bc name="ClampBack" node_set="Clamped" type="zero shell displacement">
			<sx_dof>1</sx_dof>
			<sy_dof>1</sy_dof>
			<sz_dof>1</sz_dof>
		</bc>
		<bc name="FixApex" node_set="ApexNode" type="zero displacement">
			<x_dof>1</x_dof>
			<y_dof>1</y_dof>
			<z_dof>1</z_dof>
		</bc>
	</Boundary>
	<Loads>
		<nodal_load name="Lift" node_set="Loaded" type="nodal_load">
			<relative>0</relative>
			<dof>z</dof>
			<scale lc="1">0.001</scale>
		</nodal_load>
	</Loads>
	<LoadData>
		<load_controller id="1" name="LC1" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0.0,0.0</pt>
				<pt>1.0,1.0</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement" />
			<var type="stress" />
		</plotfile>
		<logfile>
			<node_data data="ux;uy;uz" file="shell_patch_truss_chords_nodes.txt" />
			<element_data data="sx;sy;sz;sxy;syz;sxz" file="shell_patch_truss_chords_elements.txt" />
		</logfile>
	</Output>
</febio_spec>
