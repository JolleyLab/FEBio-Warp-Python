	<Boundary>
		<bc name="FixBottom" node_set="Bottom" type="zero displacement">
			<x_dof>1</x_dof>
			<y_dof>1</y_dof>
			<z_dof>1</z_dof>
		</bc>
		<bc name="PullTop" node_set="Top" type="prescribed displacement">
