<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
A material parameter on a load curve: the effective-modulus device law.

One neo-Hookean hex8 under a constant tension of 0.05 on the top face.
Young's modulus follows a load curve: 1 until t = 0.5, then 0.25, the
step in modulus used for the frame in Zelonis et al. (arXiv 2507.06337).
The stretch grows when the modulus drops.

Generated by references/small_problems/generate.py (FEBio-Warp verification harness). Synthetic.
-->
<febio_spec version="4.0">
	<Module type="solid"/>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>10</time_steps>
		<step_size>0.1</step_size>
		<solver type="solid">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
			<max_refs>25</max_refs>
			<dtol>1e-7</dtol>
			<etol>1e-12</etol>
			<rtol>0</rtol>
			<lstol>0.9</lstol>
			<qn_method type="BFGS">
				<max_ups>0</max_ups>
			</qn_method>
		</solver>
	</Control>
	<Material>
		<material id="1" name="m" type="neo-Hookean">
			<density>1</density>
			<E lc="2">1</E>
			<v>0.3</v>
		</material>
	</Material>
	<Mesh>
		<Nodes name="Object1">
			<node id="1">0,0,0</node>
			<node id="2">1,0,0</node>
			<node id="3">0,1,0</node>
			<node id="4">1,1,0</node>
			<node id="5">0,0,1</node>
			<node id="6">1,0,1</node>
			<node id="7">0,1,1</node>
			<node id="8">1,1,1</node>
		</Nodes>
		<Elements type="hex8" name="Part1">
			<elem id="1">1,2,4,3,5,6,8,7</elem>
		</Elements>
		<NodeSet name="x0">1,3,5,7</NodeSet>
		<NodeSet name="y0">1,2,5,6</NodeSet>
		<NodeSet name="z0">1,2,3,4</NodeSet>
		<Surface name="top">
			<quad4 id="1">5,6,8,7</quad4>
		</Surface>
	</Mesh>
	<MeshDomains>
		<SolidDomain name="Part1" mat="m"/>
	</MeshDomains>
	<Boundary>
		<bc name="symx" node_set="x0" type="zero displacement">
			<x_dof>1</x_dof><y_dof>0</y_dof><z_dof>0</z_dof>
		</bc>
		<bc name="symy" node_set="y0" type="zero displacement">
			<x_dof>0</x_dof><y_dof>1</y_dof><z_dof>0</z_dof>
		</bc>
		<bc name="symz" node_set="z0" type="zero displacement">
			<x_dof>0</x_dof><y_dof>0</y_dof><z_dof>1</z_dof>
		</bc>
	</Boundary>
	<Loads>
		<surface_load name="pull" surface="top" type="pressure">
			<pressure lc="1">-0.05</pressure>
			<symmetric_stiffness>1</symmetric_stiffness>
			<linear>0</linear>
		</surface_load>
	</Loads>
	<LoadData>
		<load_controller id="1" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>0.2,1</pt>
				<pt>1,1</pt>
			</points>
		</load_controller>
		<load_controller id="2" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,1</pt>
				<pt>0.5,1</pt>
				<pt>0.6,0.25</pt>
				<pt>1,0.25</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
			<var type="reaction forces"/>
		</plotfile>
		<logfile>
			<node_data data="ux;uy;uz" delim=",">8</node_data>
			<element_data data="Fxx;Fxy;Fxz;Fyx;Fyy;Fyz;Fzx;Fzy;Fzz" delim=","/>
			<element_data data="sx;sy;sz;sxy;syz;sxz" delim=","/>
		</logfile>
	</Output>
</febio_spec>
