<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
One nonlinear spring between a fixed block and a translated block.

Force curve and scale are those of chord A1 in the mitral model: slack up
to 4 mm of elongation, then 60 N/mm. The upper block is translated rigidly
(so it carries no stress) by 0 -> 6 -> 0 mm; the spring force is the only
load on it and is read as "discrete element force" and as the reaction.
Expected: force = 60 * max(0, elongation - 4).

Generated by references/small_problems/generate.py (FEBio-Warp verification harness). Synthetic.
-->
<febio_spec version="4.0">
	<Module type="solid"/>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>24</time_steps>
		<step_size>0.5</step_size>
		<solver type="solid">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
			<max_refs>25</max_refs>
			<dtol>1e-7</dtol>
			<etol>1e-12</etol>
			<rtol>0</rtol>
			<lstol>0.9</lstol>
			<qn_method type="BFGS">
				<max_ups>0</max_ups>
			</qn_method>
		</solver>
	</Control>
	<Material>
		<material id="1" name="block" type="neo-Hookean">
			<density>1</density>
			<E>1</E>
			<v>0.3</v>
		</material>
	</Material>
	<Mesh>
		<Nodes name="Lower">
			<node id="1">0,0,0</node>
			<node id="2">1,0,0</node>
			<node id="3">0,1,0</node>
			<node id="4">1,1,0</node>
			<node id="5">0,0,1</node>
			<node id="6">1,0,1</node>
			<node id="7">0,1,1</node>
			<node id="8">1,1,1</node>
		</Nodes>
		<Nodes name="Upper">
			<node id="9">0,0,11</node>
			<node id="10">1,0,11</node>
			<node id="11">0,1,11</node>
			<node id="12">1,1,11</node>
			<node id="13">0,0,12</node>
			<node id="14">1,0,12</node>
			<node id="15">0,1,12</node>
			<node id="16">1,1,12</node>
		</Nodes>
		<Elements type="hex8" name="PartLower">
			<elem id="1">1,2,4,3,5,6,8,7</elem>
		</Elements>
		<Elements type="hex8" name="PartUpper">
			<elem id="2">9,10,12,11,13,14,16,15</elem>
		</Elements>
		<NodeSet name="lower">1,2,3,4,5,6,7,8</NodeSet>
		<NodeSet name="upper">9,10,11,12,13,14,15,16</NodeSet>
		<DiscreteSet name="chord">
			<delem>5,9</delem>
		</DiscreteSet>
	</Mesh>
	<MeshDomains>
		<SolidDomain name="PartLower" mat="block"/>
		<SolidDomain name="PartUpper" mat="block"/>
	</MeshDomains>
	<Boundary>
		<bc name="fix" node_set="lower" type="zero displacement">
			<x_dof>1</x_dof><y_dof>1</y_dof><z_dof>1</z_dof>
		</bc>
		<bc name="fixxy" node_set="upper" type="zero displacement">
			<x_dof>1</x_dof><y_dof>1</y_dof><z_dof>0</z_dof>
		</bc>
		<bc name="pull" node_set="upper" type="prescribed displacement">
			<dof>z</dof>
			<value lc="1">1</value>
			<relative>0</relative>
		</bc>
	</Boundary>
	<Discrete>
		<discrete_material id="1" name="chord" type="nonlinear spring">
			<scale>60</scale>
			<measure>elongation</measure>
			<force type="point">
				<interpolate>linear</interpolate>
				<extend>extrapolate</extend>
				<points>
					<pt>0,0</pt>
					<pt>4,0</pt>
					<pt>5,1</pt>
				</points>
			</force>
		</discrete_material>
		<discrete dmat="1" discrete_set="chord"/>
	</Discrete>
	<LoadData>
		<load_controller id="1" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>6,6</pt>
				<pt>12,0</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
			<var type="reaction forces"/>
		</plotfile>
		<logfile>
			<node_data data="uz;Rz" delim=",">9</node_data>
			<element_data data="discrete element elongation;discrete element force" delim="," elem_set="chord"/>
		</logfile>
	</Output>
</febio_spec>
