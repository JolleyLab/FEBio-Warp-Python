<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
A block held by four spring chords from one fixed point.

The geometry of ch_truss_chords, with the chords as springs of FEBio's
three spring types, one discrete set each:

    linear        one chord, "linear spring", E = 15 N/mm
    tension_only  two chords, "tension-only linear spring", E = 15 N/mm,
                  slack_length = 0.05 mm
    curve         one chord, "nonlinear spring" with the three-point
                  curve of the valve models, written so that it is the
                  same law as tension_only (slack 0.05 mm, then 15 N/mm)

15 N/mm is the stiffness E A / L of a 10 mm chord of the truss case. The
upper face of the block is moved 0.3 mm away from the point by a
prescribed displacement, and not by a load as in the truss case: with
three of the four chords slack at the start, a load-driven block would
have no stiffness against tilting in the first iteration. The chords pass
from slack into tension during the run.

Generated by references/small_problems/generate.py (FEBio-Warp verification harness). Synthetic.
-->
<febio_spec version="4.0">
	<Module type="solid"/>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>10</time_steps>
		<step_size>0.1</step_size>
		<solver type="solid">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
			<max_refs>25</max_refs>
			<dtol>1e-7</dtol>
			<etol>1e-12</etol>
			<rtol>0</rtol>
			<lstol>0.9</lstol>
			<qn_method type="BFGS">
				<max_ups>0</max_ups>
			</qn_method>
		</solver>
	</Control>
	<Material>
		<material id="1" name="block" type="neo-Hookean">
			<density>1</density>
			<E>100</E>
			<v>0.3</v>
		</material>
	</Material>
	<Mesh>
		<Nodes name="Block">
			<node id="1">0,0,10</node>
			<node id="2">2,0,10</node>
			<node id="3">0,2,10</node>
			<node id="4">2,2,10</node>
			<node id="5">0,0,11</node>
			<node id="6">2,0,11</node>
			<node id="7">0,2,11</node>
			<node id="8">2,2,11</node>
		</Nodes>
		<Nodes name="Apex">
			<node id="9">0.40000000000000002,0.69999999999999996,0</node>
		</Nodes>
		<Elements type="hex8" name="Block">
			<elem id="1">1,2,4,3,5,6,8,7</elem>
		</Elements>
		<DiscreteSet name="linear">
			<delem>9,1</delem>
		</DiscreteSet>
		<DiscreteSet name="tension_only">
			<delem>9,2</delem>
			<delem>9,3</delem>
		</DiscreteSet>
		<DiscreteSet name="curve">
			<delem>9,4</delem>
		</DiscreteSet>
		<NodeSet name="apex">9</NodeSet>
		<NodeSet name="upper">5,6,7,8</NodeSet>
	</Mesh>
	<MeshDomains>
		<SolidDomain name="Block" mat="block"/>
	</MeshDomains>
	<Boundary>
		<bc name="fix" node_set="apex" type="zero displacement">
			<x_dof>1</x_dof><y_dof>1</y_dof><z_dof>1</z_dof>
		</bc>
		<bc name="guide" node_set="upper" type="zero displacement">
			<x_dof>1</x_dof><y_dof>1</y_dof><z_dof>0</z_dof>
		</bc>
		<bc name="pull" node_set="upper" type="prescribed displacement">
			<dof>z</dof>
			<value lc="1">0.3</value>
			<relative>0</relative>
		</bc>
	</Boundary>
	<Discrete>
		<discrete_material id="1" name="linear" type="linear spring">
			<E>15</E>
		</discrete_material>
		<discrete_material id="2" name="tension_only" type="tension-only linear spring">
			<E>15</E>
			<slack_length>0.05</slack_length>
		</discrete_material>
		<discrete_material id="3" name="curve" type="nonlinear spring">
			<scale>15</scale>
			<measure>elongation</measure>
			<force type="point">
				<interpolate>linear</interpolate>
				<extend>extrapolate</extend>
				<points>
					<pt>0,0</pt>
					<pt>0.05,0</pt>
					<pt>1.05,1</pt>
				</points>
			</force>
		</discrete_material>
		<discrete dmat="1" discrete_set="linear"/>
		<discrete dmat="2" discrete_set="tension_only"/>
		<discrete dmat="3" discrete_set="curve"/>
	</Discrete>
	<LoadData>
		<load_controller id="1" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>1,1</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
			<var type="reaction forces"/>
		</plotfile>
		<logfile>
			<node_data data="ux;uy;uz" delim=",">1,2,3,4,5,6,7,8</node_data>
			<node_data data="Rx;Ry;Rz" delim=",">5,6,7,8</node_data>
			<element_data data="discrete element elongation;discrete element force" delim="," elem_set="linear"/>
			<element_data data="discrete element elongation;discrete element force" delim="," elem_set="tension_only"/>
			<element_data data="discrete element elongation;discrete element force" delim="," elem_set="curve"/>
		</logfile>
	</Output>
</febio_spec>
