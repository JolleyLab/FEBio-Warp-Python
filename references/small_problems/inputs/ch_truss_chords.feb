<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
A block held by four truss chords from one fixed point.

Trusses that share nodes with solid elements, in a network where the load
is shared: the four chords run from a fixed point (a papillary tip) to the
lower corners of a block, and the block is pulled away from the point by
10 N in total. The point is off the axis of the block, so the chords have
four lengths and four tensions. Chord material as in Mangine, Laurence et
al. (arXiv 2411.09599): linear truss, E = 150 MPa, area 1 mm^2.
The chord tension is not a FEBio output for trusses. It follows from the
logged Cauchy stress as N = s A L / l, with s the stress along the chord
(v = 0.5, so J = 1), and the four tensions balance the applied load.

Generated by references/small_problems/generate.py (FEBio-Warp verification harness). Synthetic.
-->
<febio_spec version="4.0">
	<Module type="solid"/>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>10</time_steps>
		<step_size>0.1</step_size>
		<solver type="solid">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
			<max_refs>25</max_refs>
			<dtol>1e-7</dtol>
			<etol>1e-12</etol>
			<rtol>0</rtol>
			<lstol>0.9</lstol>
			<qn_method type="BFGS">
				<max_ups>0</max_ups>
			</qn_method>
		</solver>
	</Control>
	<Material>
		<material id="1" name="block" type="neo-Hookean">
			<density>1</density>
			<E>100</E>
			<v>0.3</v>
		</material>
		<material id="2" name="chord" type="linear truss">
			<density>1.04e-06</density>
			<E>150</E>
		</material>
	</Material>
	<Mesh>
		<Nodes name="Block">
			<node id="1">0,0,10</node>
			<node id="2">2,0,10</node>
			<node id="3">0,2,10</node>
			<node id="4">2,2,10</node>
			<node id="5">0,0,11</node>
			<node id="6">2,0,11</node>
			<node id="7">0,2,11</node>
			<node id="8">2,2,11</node>
		</Nodes>
		<Nodes name="Apex">
			<node id="9">0.40000000000000002,0.69999999999999996,0</node>
		</Nodes>
		<Elements type="hex8" name="Block">
			<elem id="1">1,2,4,3,5,6,8,7</elem>
		</Elements>
		<Elements type="line2" name="Chords">
			<elem id="2">9,1</elem>
			<elem id="3">9,2</elem>
			<elem id="4">9,3</elem>
			<elem id="5">9,4</elem>
		</Elements>
		<NodeSet name="apex">9</NodeSet>
		<NodeSet name="upper">5,6,7,8</NodeSet>
	</Mesh>
	<MeshDomains>
		<SolidDomain name="Block" mat="block"/>
		<BeamDomain name="Chords" mat="chord" type="linear-truss">
			<cross_sectional_area>1</cross_sectional_area>
		</BeamDomain>
	</MeshDomains>
	<Boundary>
		<bc name="fix" node_set="apex" type="zero displacement">
			<x_dof>1</x_dof><y_dof>1</y_dof><z_dof>1</z_dof>
		</bc>
		<bc name="guide" node_set="upper" type="zero displacement">
			<x_dof>1</x_dof><y_dof>1</y_dof><z_dof>0</z_dof>
		</bc>
	</Boundary>
	<Loads>
		<nodal_load name="pull" node_set="upper" type="nodal_load">
			<relative>0</relative>
			<dof>z</dof>
			<scale lc="1">2.5</scale>
		</nodal_load>
	</Loads>
	<LoadData>
		<load_controller id="1" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>1,1</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
			<var type="reaction forces"/>
		</plotfile>
		<logfile>
			<node_data data="ux;uy;uz" delim=",">1,2,3,4,5,6,7,8</node_data>
			<node_data data="Rx;Ry;Rz" delim=",">5,6,7,8</node_data>
			<element_data data="sx;sy;sz;sxy;syz;sxz" delim="," elem_set="Chords"/>
		</logfile>
	</Output>
</febio_spec>
