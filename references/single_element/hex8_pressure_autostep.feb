<?xml version="1.0" encoding="ISO-8859-1"?>
<!-- FEBio-Warp single-element reference: hex8_pressure.feb with FEBio's
     automatic time stepper (opt_iter 6, dtmax from a load curve with must
     points at 0.35, 0.8 and 1.0) and max_refs 9. It checks the step
     sequence, the must points and the iteration counts, which the fixed-step
     cases do not exercise. With max_refs 8 FEBio cuts the step back 13 times
     after t = 0.955516 and stops; tests/test_run_path_pressure.py checks that
     the run path does the same. max_ups is 0 (full Newton). -->
<febio_spec version="4.0">
	<Module type="solid"/>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>10</time_steps>
		<step_size>0.1</step_size>
		<plot_zero_state>0</plot_zero_state>
		<plot_range>0,-1</plot_range>
		<plot_level>PLOT_MAJOR_ITRS</plot_level>
		<output_level>OUTPUT_MAJOR_ITRS</output_level>
		<plot_stride>1</plot_stride>
		<output_stride>1</output_stride>
		<time_stepper type="default">
			<max_retries>5</max_retries>
			<opt_iter>6</opt_iter>
			<dtmin>0</dtmin>
			<dtmax lc="2">0.3</dtmax>
			<aggressiveness>0</aggressiveness>
			<cutback>0.5</cutback>
			<dtforce>0</dtforce>
		</time_stepper>
		<solver type="solid">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
			<lstol>0.9</lstol>
			<lsmin>0.01</lsmin>
			<lsiter>5</lsiter>
			<max_refs>9</max_refs>
			<diverge_reform>1</diverge_reform>
			<reform_each_time_step>1</reform_each_time_step>
			<min_residual>1e-20</min_residual>
			<dtol>1e-05</dtol>
			<etol>1e-08</etol>
			<rtol>0</rtol>
			<qn_method type="BFGS">
				<max_ups>0</max_ups>
			</qn_method>
		</solver>
	</Control>
	<Globals>
		<Constants>
			<T>0</T>
			<P>0</P>
			<R>8.31446</R>
			<Fc>96485.3</Fc>
		</Constants>
	</Globals>
	<Material>
		<material id="1" name="Material1" type="neo-Hookean">
			<density>1</density>
			<E>1</E>
			<v>0.3</v>
		</material>
	</Material>
	<Mesh>
		<Nodes name="Object1">
			<node id="1">0,0,0</node>
			<node id="2">1,0,0</node>
			<node id="3">1,1,0</node>
			<node id="4">0,1,0</node>
			<node id="5">0,0,1</node>
			<node id="6">1,0,1</node>
			<node id="7">1,1,1</node>
			<node id="8">0,1,1</node>
		</Nodes>
		<Elements type="hex8" name="Part1">
			<elem id="1">1,2,3,4,5,6,7,8</elem>
		</Elements>
		<NodeSet name="FaceX0">1,4,5,8</NodeSet>
		<NodeSet name="FaceY0">1,2,5,6</NodeSet>
		<NodeSet name="FaceZ0">1,2,3,4</NodeSet>
		<Surface name="TopSurface">
			<quad4 id="1">5,6,7,8</quad4>
		</Surface>
	</Mesh>
	<MeshDomains>
		<SolidDomain name="Part1" mat="Material1"/>
	</MeshDomains>
	<Boundary>
		<bc name="SymmetryX" node_set="FaceX0" type="zero displacement">
			<x_dof>1</x_dof>
			<y_dof>0</y_dof>
			<z_dof>0</z_dof>
		</bc>
		<bc name="SymmetryY" node_set="FaceY0" type="zero displacement">
			<x_dof>0</x_dof>
			<y_dof>1</y_dof>
			<z_dof>0</z_dof>
		</bc>
		<bc name="SymmetryZ" node_set="FaceZ0" type="zero displacement">
			<x_dof>0</x_dof>
			<y_dof>0</y_dof>
			<z_dof>1</z_dof>
		</bc>
	</Boundary>
	<Loads>
		<surface_load name="TopPressure" surface="TopSurface" type="pressure">
			<pressure lc="1">0.2</pressure>
			<symmetric_stiffness>1</symmetric_stiffness>
			<linear>0</linear>
			<shell_bottom>0</shell_bottom>
		</surface_load>
	</Loads>
	<LoadData>
		<load_controller id="1" name="LC1" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>1,1</pt>
			</points>
		</load_controller>
		<load_controller id="2" name="MustPoints" type="loadcurve">
			<interpolate>STEP</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0.0,0.3</pt>
				<pt>0.35,0.3</pt>
				<pt>0.8,0.3</pt>
				<pt>1.0,0.3</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
		</plotfile>
		<logfile>
			<node_data data="ux;uy;uz" file="hex8_pressure_autostep_nodes.txt"/>
			<element_data data="sx;sy;sz;sxy;syz;sxz" file="hex8_pressure_autostep_elements.txt"/>
		</logfile>
	</Output>
</febio_spec>
