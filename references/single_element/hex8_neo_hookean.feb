<?xml version="1.0" encoding="ISO-8859-1"?>
<!-- FEBio-Warp single-element reference: one hex8, neo-Hookean.
     Bottom face fixed, top face moved in z by a load curve, lateral
     displacements of the top face free (8 unknowns). The element is mildly
     distorted so that a node-ordering or Jacobian error would show.
     Tolerances are tighter than FEBio's defaults and max_ups is 0 (full
     Newton) so both codes converge well below the comparison tolerance. -->
<febio_spec version="4.0">
	<Module type="solid"/>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>10</time_steps>
		<step_size>0.1</step_size>
		<plot_zero_state>0</plot_zero_state>
		<plot_range>0,-1</plot_range>
		<plot_level>PLOT_MAJOR_ITRS</plot_level>
		<output_level>OUTPUT_MAJOR_ITRS</output_level>
		<plot_stride>1</plot_stride>
		<output_stride>1</output_stride>
		<solver type="solid">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
			<lstol>0.9</lstol>
			<lsmin>0.01</lsmin>
			<lsiter>5</lsiter>
			<max_refs>15</max_refs>
			<diverge_reform>1</diverge_reform>
			<reform_each_time_step>1</reform_each_time_step>
			<min_residual>1e-20</min_residual>
			<dtol>1e-08</dtol>
			<etol>1e-12</etol>
			<rtol>0</rtol>
			<qn_method type="BFGS">
				<max_ups>0</max_ups>
			</qn_method>
		</solver>
	</Control>
	<Globals>
		<Constants>
			<T>0</T>
			<P>0</P>
			<R>8.31446</R>
			<Fc>96485.3</Fc>
		</Constants>
	</Globals>
	<Material>
		<material id="1" name="Material1" type="neo-Hookean">
			<density>1</density>
			<E>1</E>
			<v>0.3</v>
		</material>
	</Material>
	<Mesh>
		<Nodes name="Object1">
			<node id="1">0,0,0</node>
			<node id="2">1,0,0</node>
			<node id="3">1.1,1,0</node>
			<node id="4">0,0.9,0</node>
			<node id="5">0.05,0,1</node>
			<node id="6">1,0.1,1.1</node>
			<node id="7">1,1,1</node>
			<node id="8">0,1,0.95</node>
		</Nodes>
		<Elements type="hex8" name="Part1">
			<elem id="1">1,2,3,4,5,6,7,8</elem>
		</Elements>
		<NodeSet name="Bottom">1,2,3,4</NodeSet>
		<NodeSet name="Top">5,6,7,8</NodeSet>
		<Surface name="TopSurface">
			<quad4 id="1">5,6,7,8</quad4>
		</Surface>
	</Mesh>
	<MeshDomains>
		<SolidDomain name="Part1" mat="Material1"/>
	</MeshDomains>
	<Boundary>
		<bc name="FixBottom" node_set="Bottom" type="zero displacement">
			<x_dof>1</x_dof>
			<y_dof>1</y_dof>
			<z_dof>1</z_dof>
		</bc>
		<bc name="PullTop" node_set="Top" type="prescribed displacement">
			<dof>z</dof>
			<value lc="1">0.3</value>
			<relative>0</relative>
		</bc>
	</Boundary>
	<LoadData>
		<load_controller id="1" name="LC1" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>1,1</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
		</plotfile>
		<logfile>
			<node_data data="ux;uy;uz" file="hex8_neo_hookean_nodes.txt"/>
			<element_data data="sx;sy;sz;sxy;syz;sxz" file="hex8_neo_hookean_elements.txt"/>
		</logfile>
	</Output>
</febio_spec>
