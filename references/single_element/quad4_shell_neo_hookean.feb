<?xml version="1.0" encoding="ISO-8859-1"?>
<!-- FEBio-Warp single-element reference: one quad4 shell (elastic-shell),
     neo-Hookean, thickness 0.1. The edge x = 0 is fixed on both faces. The
     front face of the opposite edge is moved in x (stretch) and z (bending).
     Free: y of that edge and its back-face displacement (8 unknowns).
     Tolerances as in the hex8 reference. -->
<febio_spec version="4.0">
	<Module type="solid"/>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>10</time_steps>
		<step_size>0.1</step_size>
		<plot_zero_state>0</plot_zero_state>
		<plot_range>0,-1</plot_range>
		<plot_level>PLOT_MAJOR_ITRS</plot_level>
		<output_level>OUTPUT_MAJOR_ITRS</output_level>
		<plot_stride>1</plot_stride>
		<output_stride>1</output_stride>
		<solver type="solid">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
			<lstol>0.9</lstol>
			<lsmin>0.01</lsmin>
			<lsiter>5</lsiter>
			<max_refs>15</max_refs>
			<diverge_reform>1</diverge_reform>
			<reform_each_time_step>1</reform_each_time_step>
			<min_residual>1e-20</min_residual>
			<dtol>1e-08</dtol>
			<etol>1e-12</etol>
			<rtol>0</rtol>
			<qn_method type="BFGS">
				<max_ups>0</max_ups>
			</qn_method>
		</solver>
	</Control>
	<Globals>
		<Constants>
			<T>0</T>
			<P>0</P>
			<R>8.31446</R>
			<Fc>96485.3</Fc>
		</Constants>
	</Globals>
	<Material>
		<material id="1" name="Material1" type="neo-Hookean">
			<density>1</density>
			<E>1</E>
			<v>0.3</v>
		</material>
	</Material>
	<Mesh>
		<Nodes name="Object1">
			<node id="1">0,0,0</node>
			<node id="2">1,0,0</node>
			<node id="3">1.1,1,0.05</node>
			<node id="4">0,0.9,0</node>
		</Nodes>
		<Elements type="quad4" name="Part1">
			<elem id="1">1,2,3,4</elem>
		</Elements>
		<NodeSet name="Clamped">1,4</NodeSet>
		<NodeSet name="Moved">2,3</NodeSet>
	</Mesh>
	<MeshDomains>
		<ShellDomain name="Part1" mat="Material1" type="elastic-shell">
			<shell_thickness>0.1</shell_thickness>
		</ShellDomain>
	</MeshDomains>
	<Boundary>
		<bc name="ClampFront" node_set="Clamped" type="zero displacement">
			<x_dof>1</x_dof>
			<y_dof>1</y_dof>
			<z_dof>1</z_dof>
		</bc>
		<bc name="ClampBack" node_set="Clamped" type="zero shell displacement">
			<sx_dof>1</sx_dof>
			<sy_dof>1</sy_dof>
			<sz_dof>1</sz_dof>
		</bc>
		<bc name="Stretch" node_set="Moved" type="prescribed displacement">
			<dof>x</dof>
			<value lc="1">0.1</value>
			<relative>0</relative>
		</bc>
		<bc name="Lift" node_set="Moved" type="prescribed displacement">
			<dof>z</dof>
			<value lc="1">0.2</value>
			<relative>0</relative>
		</bc>
	</Boundary>
	<LoadData>
		<load_controller id="1" name="LC1" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>1,1</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
		</plotfile>
		<logfile>
			<node_data data="ux;uy;uz" file="quad4_shell_neo_hookean_nodes.txt"/>
			<element_data data="sx;sy;sz;sxy;syz;sxz" file="quad4_shell_neo_hookean_elements.txt"/>
		</logfile>
	</Output>
</febio_spec>
