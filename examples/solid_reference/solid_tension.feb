<?xml version="1.0" encoding="ISO-8859-1"?>
<febio_spec version="4.0">
	<Module type="solid"/>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>10</time_steps>
		<step_size>0.1</step_size>
		<plot_zero_state>0</plot_zero_state>
		<plot_range>0,-1</plot_range>
		<plot_level>PLOT_MAJOR_ITRS</plot_level>
		<output_level>OUTPUT_MAJOR_ITRS</output_level>
		<plot_stride>1</plot_stride>
		<output_stride>1</output_stride>
		<adaptor_re_solve>1</adaptor_re_solve>
		<time_stepper type="default">
			<max_retries>10</max_retries>
			<opt_iter>10</opt_iter>
			<dtmin>0.01</dtmin>
			<dtmax>0.1</dtmax>
			<aggressiveness>0</aggressiveness>
			<cutback>0.5</cutback>
			<dtforce>0</dtforce>
		</time_stepper>
		<solver type="solid">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
			<equation_scheme>staggered</equation_scheme>
			<equation_order>default</equation_order>
			<optimize_bw>0</optimize_bw>
			<lstol>0.9</lstol>
			<lsmin>0.01</lsmin>
			<lsiter>5</lsiter>
			<ls_check_jacobians>0</ls_check_jacobians>
			<max_refs>25</max_refs>
			<check_zero_diagonal>0</check_zero_diagonal>
			<zero_diagonal_tol>0</zero_diagonal_tol>
			<force_partition>0</force_partition>
			<reform_each_time_step>1</reform_each_time_step>
			<reform_augment>0</reform_augment>
			<diverge_reform>1</diverge_reform>
			<min_residual>1e-20</min_residual>
			<max_residual>0</max_residual>
			<dtol>0.001</dtol>
			<etol>0.01</etol>
			<rtol>0</rtol>
			<rhoi>-2</rhoi>
			<alpha>1</alpha>
			<beta>0.25</beta>
			<gamma>0.5</gamma>
			<logSolve>0</logSolve>
			<arc_length>0</arc_length>
			<arc_length_scale>0</arc_length_scale>
			<qn_method type="BFGS">
				<max_ups>0</max_ups>
				<max_buffer_size>0</max_buffer_size>
				<cycle_buffer>1</cycle_buffer>
				<cmax>100000</cmax>
			</qn_method>
		</solver>
	</Control>
	<Globals>
		<Constants>
			<T>0</T>
			<P>0</P>
			<R>0</R>
			<Fc>0</Fc>
		</Constants>
	</Globals>
	<Material>
		<material id="1" name="NeoHookean_E1MPa_nu045" type="neo-Hookean">
			<density>1</density>
			<E>1</E>
			<v>0.45</v>
		</material>
	</Material>
	<Mesh>
		<Nodes name="BlockNodes">
			<node id="1">0,0,0</node>
			<node id="2">5,0,0</node>
			<node id="3">10,0,0</node>
			<node id="4">15,0,0</node>
			<node id="5">20,0,0</node>
			<node id="6">0,5,0</node>
			<node id="7">5,5,0</node>
			<node id="8">10,5,0</node>
			<node id="9">15,5,0</node>
			<node id="10">20,5,0</node>
			<node id="11">0,10,0</node>
			<node id="12">5,10,0</node>
			<node id="13">10,10,0</node>
			<node id="14">15,10,0</node>
			<node id="15">20,10,0</node>
			<node id="16">0,0,1</node>
			<node id="17">5,0,1</node>
			<node id="18">10,0,1</node>
			<node id="19">15,0,1</node>
			<node id="20">20,0,1</node>
			<node id="21">0,5,1</node>
			<node id="22">5,5,1</node>
			<node id="23">10,5,1</node>
			<node id="24">15,5,1</node>
			<node id="25">20,5,1</node>
			<node id="26">0,10,1</node>
			<node id="27">5,10,1</node>
			<node id="28">10,10,1</node>
			<node id="29">15,10,1</node>
			<node id="30">20,10,1</node>
		</Nodes>
		<Elements type="hex8" name="Block">
			<elem id="1">1,2,7,6,16,17,22,21</elem>
			<elem id="2">2,3,8,7,17,18,23,22</elem>
			<elem id="3">3,4,9,8,18,19,24,23</elem>
			<elem id="4">4,5,10,9,19,20,25,24</elem>
			<elem id="5">6,7,12,11,21,22,27,26</elem>
			<elem id="6">7,8,13,12,22,23,28,27</elem>
			<elem id="7">8,9,14,13,23,24,29,28</elem>
			<elem id="8">9,10,15,14,24,25,30,29</elem>
		</Elements>
		<NodeSet name="left_x0">
			1, 6, 11, 16, 21, 26
		</NodeSet>
		<NodeSet name="right_x20">
			5, 10, 15, 20, 25, 30
		</NodeSet>
		<NodeSet name="anchor_yz">
			1
		</NodeSet>
		<NodeSet name="anchor_z">
			11
		</NodeSet>
	</Mesh>
	<MeshDomains>
		<SolidDomain name="Block" mat="NeoHookean_E1MPa_nu045"/>
	</MeshDomains>
	<Boundary>
		<bc name="fix_left_x" node_set="left_x0" type="zero displacement">
			<x_dof>1</x_dof>
			<y_dof>0</y_dof>
			<z_dof>0</z_dof>
		</bc>
		<bc name="anchor_y" node_set="anchor_yz" type="zero displacement">
			<x_dof>0</x_dof>
			<y_dof>1</y_dof>
			<z_dof>1</z_dof>
		</bc>
		<bc name="anchor_z" node_set="anchor_z" type="zero displacement">
			<x_dof>0</x_dof>
			<y_dof>0</y_dof>
			<z_dof>1</z_dof>
		</bc>
		<bc name="pull_right_x" node_set="right_x20" type="prescribed displacement">
			<dof>x</dof>
			<value lc="1">2</value>
			<relative>0</relative>
		</bc>
	</Boundary>
	<LoadData>
		<load_controller id="1" name="LC_1" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>1,1</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
			<var type="relative volume"/>
		</plotfile>
		<logfile>
			<node_data data="ux;uy;uz" file="displacement.csv"/>
			<node_data data="Rx;Ry;Rz" file="reaction_force.csv"/>
			<element_data data="sx;sy;sz;sxy;syz;sxz" file="stress.csv"/>
		</logfile>
	</Output>
</febio_spec>
