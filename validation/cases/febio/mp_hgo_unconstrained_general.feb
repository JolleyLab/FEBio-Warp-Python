<?xml version="1.0" encoding="ISO-8859-1"?>
<!--
Material point check: HGO unconstrained, general deformation.
One hex8 element, every node driven by x = F X scaled by a linear ramp,
so the deformation is uniform and the logged element values are point
values. Log record 1: deformation gradient. 2: Cauchy stress.
3: spatial tangent, first 21 entries of the 6x6 stored by column.

Generated by validation/cases/generate.py (FEBio-Warp verification harness). Synthetic.
-->
<febio_spec version="4.0">
	<Module type="solid"/>
	<Control>
		<analysis>STATIC</analysis>
		<time_steps>10</time_steps>
		<step_size>0.1</step_size>
		<solver type="solid">
			<symmetric_stiffness>symmetric</symmetric_stiffness>
			<max_refs>25</max_refs>
			<dtol>1e-7</dtol>
			<etol>1e-12</etol>
			<rtol>0</rtol>
			<lstol>0.9</lstol>
			<qn_method type="BFGS">
				<max_ups>0</max_ups>
			</qn_method>
		</solver>
	</Control>
	<Material>
		<material id="1" name="m" type="HGO unconstrained">
			<density>1</density>
			<c>0.00764</c>
			<k1>0.9966</k1>
			<k2>524.6</k2>
			<kappa>0.226</kappa>
			<gamma>49.98</gamma>
			<k>100</k>
			<mat_axis type="vector"><a>1,0,0</a><d>0,1,0</d></mat_axis>
		</material>
	</Material>
	<Mesh>
		<Nodes name="Object1">
			<node id="1">0,0,0</node>
			<node id="2">1,0,0</node>
			<node id="3">0,1,0</node>
			<node id="4">1,1,0</node>
			<node id="5">0,0,1</node>
			<node id="6">1,0,1</node>
			<node id="7">0,1,1</node>
			<node id="8">1,1,1</node>
		</Nodes>
		<Elements type="hex8" name="Part1">
			<elem id="1">1,2,4,3,5,6,8,7</elem>
		</Elements>
		<NodeSet name="all">1,2,3,4,5,6,7,8</NodeSet>
	</Mesh>
	<MeshDomains>
		<SolidDomain name="Part1" mat="m"/>
	</MeshDomains>
	<Boundary>
		<bc name="F" node_set="all" type="prescribed deformation">
			<scale lc="1">1</scale>
			<F>1.007425627545885,-0.059392177736150423,0.082490442711981138,0.1236839796349174,0.98186752497737395,-0.033367491668013671,-0.04326452893857325,0.011885709260467472,0.99808151354134877</F>
		</bc>
	</Boundary>
	<LoadData>
		<load_controller id="1" type="loadcurve">
			<interpolate>LINEAR</interpolate>
			<extend>CONSTANT</extend>
			<points>
				<pt>0,0</pt>
				<pt>1,1</pt>
			</points>
		</load_controller>
	</LoadData>
	<Output>
		<plotfile type="febio">
			<var type="displacement"/>
			<var type="stress"/>
			<var type="reaction forces"/>
		</plotfile>
		<logfile>
			<element_data data="Fxx;Fxy;Fxz;Fyx;Fyy;Fyz;Fzx;Fzy;Fzz" delim=","/>
			<element_data data="sx;sy;sz;sxy;syz;sxz" delim=","/>
			<element_data data="cxxxx;cxxyy;cyyyy;cxxzz;cyyzz;czzzz;cxxxy;cyyxy;czzxy;cxyxy;cxxyz;cyyyz;czzyz;cxyyz;cyzyz;cxxxz;cyyxz;czzxz;cxyxz;cyzxz;cxzxz" delim=","/>
		</logfile>
	</Output>
</febio_spec>
